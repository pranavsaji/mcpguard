# Copy to .env (gitignored) and fill in the judges you want. `--ai auto` uses every one configured.

# Jev (TypeSafe AI) - fast, cheap yes/no decision model. https://docs.typesafe.ai
TYPESAFE_API_KEY=
# TYPESAFE_DEFAULT_MODEL=jev-latest
# MCPGUARD_JEV_TIMEOUT=10

# Claude (Anthropic) - needs `pip install 'mcpguard[claude]'`. An `ant auth login` profile also works.
ANTHROPIC_API_KEY=
# MCPGUARD_CLAUDE_MODEL=claude-opus-5
# MCPGUARD_CLAUDE_TIMEOUT=60
