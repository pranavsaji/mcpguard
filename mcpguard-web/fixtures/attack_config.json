{
  "_comment": "Shared parity fixture: one entry per 2025-2026 MCP attack class. Scanned by both engines; expected output in attack_config.expected.json (regenerate with the Python CLI).",
  "mcpServers": {
    "web": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch==2025.4.7"
