{
  "_comment": "A very common real-world mistake: pasting live API keys straight into the config instead of using ${ENV} references. Expect: SEC01 critical (GitHub token, Anthropic key, AWS key) plus SUP01 unpinned. The key values here are fake but match real vendor formats.",
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_AbCdEfGhIjKlMnOpQrStUvWxYz0123456789" }
    },
    "claude-bridge": {
      "command": "npx",
      "args": ["-y", "@example/anthropic-bridge"],
      "env": { "ANTHROPIC_API_KEY": "sk-ant-api03-Zx9_dummybutformatvalidkey1234567890ABCDEF" }
    },
    "aws-tools": {
      "command": "uvx",
      "args": ["mcp-server-aws"],
      "env": {
        "AWS_ACCESS_KEY_ID": "AKIAIOSFODNN7EXAMPLE",
        "AWS_SECRET_ACCESS_KEY": "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
      }
    }
  }
}
