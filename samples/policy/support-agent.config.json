{
  "mcpServers": {
    "support": {
      "command": "npx",
      "args": ["-y", "@acme/support-mcp@2.4.1"],
      "tools": [
        {
          "name": "search_tickets",
          "description": "Search support tickets by customer or keyword.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "query": {"type": "string", "maxLength": 200},
              "limit": {"type": "integer", "minimum": 1, "maximum": 50}
            },
            "required": ["query"]
          },
          "annotations": {"readOnlyHint": true}
        },
        {
          "name": "read_account",
          "description": "Read one customer account record.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "account_id": {"type": "string", "x-mcp-header": "Account"}
            },
            "required": ["account_id"]
          },
          "annotations": {"readOnlyHint": true}
        },
        {
          "name": "export_all_customers",
          "description": "Export every customer record as CSV.",
          "inputSchema": {
            "type": "object",
            "properties": {"format": {"type": "string", "enum": ["csv", "json"]}}
          }
        }
      ]
    },
    "mail": {
      "command": "npx",
      "args": ["-y", "@acme/mail-mcp@1.2.0"],
      "tools": [
        {
          "name": "send_email",
          "description": "Send an email.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "to": {"type": "string"},
              "subject": {"type": "string", "maxLength": 200},
              "body": {"type": "string", "maxLength": 20000}
            },
            "required": ["to", "subject", "body"]
          },
          "annotations": {"openWorldHint": true}
        }
      ]
    }
  }
}
